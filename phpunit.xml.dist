<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	colors="true"
	executionOrder="default"
	cacheDirectory=".phpunit-cache">
	<!--
		One WP boot, sequenced deliberately. RegistrarTest owns the lazy init
		firing (its first test asserts did_action() === 0 and queues the
		deferred hooks; its second test fires the registry via the
		Registrar's reopen helper); ManifestTest is registry-free; the
		abilities tests read a settled registry produced by 1-registrar.
		PHPUnit orders nested testsuites alphabetically, so the numbered
		prefixes encode the required sequence. Do not re-sort these entries.
	-->
	<testsuites>
		<testsuite name="1-registrar">
			<file>tests/RegistrarTest.php</file>
		</testsuite>
		<testsuite name="2-manifest">
			<file>tests/ManifestTest.php</file>
		</testsuite>
		<testsuite name="3-abilities">
			<directory>tests/Abilities</directory>
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory>src</directory>
		</include>
	</source>
	<php>
		<ini name="error_reporting" value="E_ALL"/>
	</php>
</phpunit>